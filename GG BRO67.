local function createPlayerButton(player)
    if player == LocalPlayer then return end
    
    local pButton = Instance.new("TextButton")
    pButton.Name = player.Name
    pButton.Parent = FriendsScrolling
    pButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    pButton.Size = UDim2.new(1, -5, 0, 34) -- Tamaño ligeramente mayor para acomodar el inventario
    pButton.Font = Enum.Font.SourceSansBold
    pButton.Text = player.Name .. "\n[Armas: Ninguna]"
    pButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    pButton.TextSize = 11
    
    -- Evento al hacer clic en el botón para ignorar/des-ignorar del aimbot
    pButton.MouseButton1Click:Connect(function()
        if ignoredPlayers[player] then
            ignoredPlayers[player] = nil
            pButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            ignoredPlayers[player] = true
            pButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0) -- Rojo (Ignorado)
        end
    end)
    
    FriendsScrolling.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

for _, p in ipairs(Players:GetPlayers()) do
    createPlayerButton(p)
end

Players.PlayerAdded:Connect(createPlayerButton)

Players.PlayerRemoving:Connect(function(player)
    ignoredPlayers[player] = nil
    local btn = FriendsScrolling:FindFirstChild(player.Name)
    if btn then btn:Destroy() end
end)

