    HideNameButton.BackgroundColor3 = hideNameEnabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
    HideNameButton.Text = hideNameEnabled and "Ocultar Nombre: ON" or "Ocultar Nombre: OFF"
    
    toggleHideName(hideNameEnabled)
end)

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    newCharacter:WaitForChild("Humanoid")
    if hideNameEnabled then
        task.wait(0.5)
        toggleHideName(true)
    end
end)

---------------------------------------------------
-- BUCLE PRINCIPAL (RENDERSTEPPED)
---------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- Actualizar FOV y colores si el aimbot está activo
    if aimbotEnabled then
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local hue = tick() % 5 / 5
        fovCircle.Color = Color3.fromHSV(hue, 1, 1)

        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end

    -- Spinbot Loop (Usa la velocidad seleccionada en el slider de 1 al 50)
    if spinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local rootPart = LocalPlayer.Character.HumanoidRootPart
        rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
    end
end)
